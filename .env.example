# CashlessIQ never reads Snowflake passwords from this file. Configure the
# `cashlessiq` connection in ~/.snowflake/connections.toml instead.
CASHLESSIQ_SNOWFLAKE_CONNECTION=cashlessiq
# Resource monitors use Snowflake credit units, not the trial's dollar balance.
CASHLESSIQ_RESOURCE_MONITOR_CREDITS=10

# Product foundation: make product-up generates .env.product.local privately.
# Do not put real values into this example. These placeholders are not a runnable config.
# CIQ_ENVIRONMENT=local
# CIQ_AUTH_MODE=local
# CIQ_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# CIQ_LOCAL_AUTH_SECRET=<random-at-least-32-characters>
# CIQ_DB_PASSWORD=<random-local-postgres-password>
# CIQ_API_URL=http://api:8000
# CIQ_WEB_ORIGIN=http://localhost:3000
# For staging/customer OIDC (local bootstrap is unavailable):
# CIQ_AUTH_MODE=oidc
# CIQ_OIDC_ISSUER=https://<customer-issuer>
# CIQ_OIDC_AUDIENCE=cashlessiq-api
# CIQ_OIDC_JWKS_URL=https://<customer-issuer>/<jwks-path>
