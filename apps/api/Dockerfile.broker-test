# Explicit synthetic integration artifact; not compose.product.yml or API startup.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
WORKDIR /app/apps/api
RUN pip install --no-cache-dir uv==0.11.25
COPY apps/api/pyproject.toml apps/api/uv.lock ./
COPY apps/api/src/ciq_api/__init__.py apps/api/src/ciq_api/auth.py apps/api/src/ciq_api/models.py apps/api/src/ciq_api/config.py apps/api/src/ciq_api/contracts.py apps/api/src/ciq_api/source_contracts.py apps/api/src/ciq_api/source_identity.py apps/api/src/ciq_api/source_models.py apps/api/src/ciq_api/source_alpha.py apps/api/src/ciq_api/source_scopes.py ./src/ciq_api/
COPY apps/api/src/ciq_api/validation_worker.py apps/api/src/ciq_api/worker_authority.py apps/api/src/ciq_api/worker_delegation.py apps/api/src/ciq_api/worker_replay.py apps/api/src/ciq_api/worker_clock.py apps/api/src/ciq_api/worker_health.py apps/api/src/ciq_api/worker_guard_state.py apps/api/src/ciq_api/worker_guard_health.py apps/api/src/ciq_api/worker_guard_authority.py apps/api/src/ciq_api/worker_guard_transport.py apps/api/src/ciq_api/worker_transport.py apps/api/src/ciq_api/worker_membership.py apps/api/src/ciq_api/worker_broker.py apps/api/src/ciq_api/worker_guard_broker.py ./src/ciq_api/
COPY packages/domain /app/packages/domain
COPY src/cashlessiq/rules /app/src/cashlessiq/rules
COPY src/cashlessiq/decision_schema.py src/cashlessiq/source_decision.py src/cashlessiq/source_history.py src/cashlessiq/source_recommendation.py /app/src/cashlessiq/
RUN uv sync --frozen --no-dev
COPY apps/api/tests/broker_composition_service.py apps/api/tests/broker_composition_fixture.py apps/worker/tests/guard_mtls_fixture.py /opt/ciq-composition/
COPY apps/api/tests/composition_client.py /opt/ciq-composition/
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["/app/apps/api/.venv/bin/python", "/opt/ciq-composition/broker_composition_service.py"]
CMD []
