{
	admin off
	auto_https off
}

# Only the loopback port is published. Remote access requires a separate HTTPS
# tunnel to this gateway, never directly to the web/API/database containers.
:8080 {
	header {
		>Cache-Control "no-store"
		>X-Robots-Tag "noindex, nofollow, noarchive"
	}
	route {
		basic_auth {
			owner {$CIQ_PREVIEW_PASSWORD_HASH}
		}
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
	handle_errors {
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
