{
  "name": "cashlessiq-product",
  "private": true,
  "workspaces": ["apps/web", "packages/api-client"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @cashlessiq/web",
    "build": "npm run build --workspace @cashlessiq/web",
    "typecheck": "npm run typecheck --workspace @cashlessiq/web && tsc --project packages/api-client/tsconfig.json",
    "lint": "npm run lint --workspace @cashlessiq/web && biome lint packages/api-client/src tests/client tests/source_e2e/*.ts playwright.client.config.ts playwright.source.config.ts",
    "contracts": "openapi-typescript packages/contracts/openapi.json -o packages/api-client/src/schema.d.ts",
    "test:browser": "playwright test",
    "test:client": "playwright test --config playwright.client.config.ts",
    "test:source-ui": "playwright test --config playwright.source.config.ts",
    "test:browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0"
  }
}
